MYSQL_ROOT_PASSWORD=troque_a_senha_root_local
MYSQL_PASSWORD=troque_a_senha_local
DATABASE_URL="mysql://unifor_app:troque_a_senha_local@127.0.0.1:3308/unifor_hub"

# Origens do frontend aceitas pelo CORS, separadas por vírgula.
# Para acessar pela rede local, inclua também http://<SEU_IP>:5173
CORS_ORIGINS=http://localhost:5173

# Administrador criado pelo seed (npm run seed). A senha é obrigatória (15 a 128 caracteres).
SEED_ADMIN_NOME="Administrador Unifor Sports"
SEED_ADMIN_EMAIL=admin@unifor.br
SEED_ADMIN_MATRICULA=0010001
SEED_ADMIN_SENHA=troque_por_uma_senha_longa_local
